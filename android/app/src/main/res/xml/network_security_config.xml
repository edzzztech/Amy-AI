<?xml version="1.0" encoding="utf-8"?>
<!--
  The desktop link talks plain HTTP to Amy on a computer on your own network.
  Android blocks cleartext traffic by default, which silently broke pairing:
  every request failed before it left the phone.

  Permitting it is safe here because the desktop link is the only thing in the
  app that makes network requests, it only ever addresses a private LAN address
  that you typed in, and every request carries the pairing code.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- A domain-config cannot name "any private address", so the base config
         has to allow it. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
