<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 10 and 11 read this instead of data_extraction_rules.xml. The same
  rule: conversations, the action log and the pairing code stay on the phone.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
