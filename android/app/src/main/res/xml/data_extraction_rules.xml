<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone. Conversations, the action log and the desktop
  pairing code are personal, and the pairing code is a secret: none of it
  belongs in a cloud backup or a device-to-device copy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
